# CreatorOS AI — Environment Variables
# Copy to .env.local for local development. Never commit real keys to Git.

# Supabase Client Configuration (Safe for client-side exposure)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Supabase Server Privileges (Server/Edge runtime only — do NOT expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI Provider Configuration (Server runtime only for cloud completions)
AI_PROVIDER_API_KEY=your_openai_or_provider_api_key_here
AI_MODEL=gpt-4o-mini
